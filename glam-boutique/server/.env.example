# Copie este arquivo para ".env" e ajuste com as credenciais do seu MySQL Workbench / servidor MySQL.

# Conexão com o MySQL (a mesma usada na conexão do MySQL Workbench)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glam_boutique

# Porta em que a API vai rodar
PORT=3333

# URL do frontend (para liberar CORS) — ajuste se for diferente
CORS_ORIGIN=http://localhost:5173

# Autenticação do painel administrativo
# Gere o hash da senha com: node scripts/hashPassword.js "sua-senha-segura"
ADMIN_EMAIL=admin@glamboutique.com.br
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=troque-por-uma-string-aleatoria-longa-e-secreta
