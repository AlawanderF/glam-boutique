# Exemplo de configuração Nginx para a Glam Boutique.
# Copie o conteúdo do bloco "server" para /etc/nginx/sites-available/glamboutique
# e ajuste o caminho de "root" para onde está a pasta dist/ gerada pelo build.

server {
  listen 80;
  server_name glamboutique.com.br www.glamboutique.com.br;

  root /var/www/glamboutique/dist;
  index index.html;

  # Fallback de SPA — essencial para rotas como /produto/x e /admin
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Cache agressivo para assets com hash no nome (gerados pelo Vite)
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  add_header X-Content-Type-Options "nosniff";
  add_header X-Frame-Options "DENY";
  add_header Referrer-Policy "strict-origin-when-cross-origin";

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Proxy reverso para a API Node (porta 3333). O backend escuta em 127.0.0.1
  # dentro do mesmo servidor; Nginx encaminha /api/* sem precisar de domínio separado.
  location /api/ {
    proxy_pass http://127.0.0.1:3333/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }
}

# Depois de configurar o domínio, gere HTTPS gratuito com Certbot:
#   sudo certbot --nginx -d glamboutique.com.br -d www.glamboutique.com.br
