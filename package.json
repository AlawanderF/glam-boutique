{
  "name": "glam-boutique",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce completo para Glam Boutique — roupas, calçados e acessórios com painel administrativo",
  "author": "AlawanderF",
  "license": "MIT",
  "keywords": [
    "e-commerce",
    "boutique",
    "fashion",
    "react",
    "vite",
    "typescript",
    "zustand",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlawanderF/glam-boutique.git"
  },
  "bugs": {
    "url": "https://github.com/AlawanderF/glam-boutique/issues"
  },
  "homepage": "https://github.com/AlawanderF/glam-boutique#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && tsc -b && vite build",
    "build:gh-pages": "npm run sitemap && tsc -b && vite build && npm run copy-404",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "copy-404": "node scripts/copy-404.mjs",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
