# ============================================================
# Glam Boutique — Backend
# ============================================================
# Copie para .env: cp .env.example .env
# NUNCA commite o .env real!

# Conexão MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glam_boutique

# Porta da API
PORT=3333

# Frontend URL (para links nos e-mails)
FRONTEND_URL=http://localhost:5173

# Origens CORS (vírgula para múltiplas)
# Local: http://localhost:5173
# Produção: https://seudominio.com.br
CORS_ORIGIN=http://localhost:5173

# Autenticação admin
# Gere o hash da senha:
#   node scripts/hashPassword.js "sua-senha-segura"
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD_HASH=

# Gere um secret forte:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=

# SMTP para e-mails transacionais
# Recomendado: Resend (resend.com), SendGrid, Amazon SES, ou SMTP do seu provedor
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@glamboutique.com.br

# Ambiente
NODE_ENV=production
