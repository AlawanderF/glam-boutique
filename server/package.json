{
  "name": "glam-boutique-server",
  "version": "1.0.0",
  "description": "API backend da Glam Boutique — integração com MySQL para vendas, saídas, analytics e métodos de pagamento.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:schema": "node scripts/runSqlFile.js schema.sql",
    "db:seed": "node scripts/runSqlFile.js seed.sql",
    "db:setup": "node scripts/runSqlFile.js schema.sql && node scripts/runSqlFile.js seed.sql",
    "db:reset": "node scripts/runSqlFile.js schema.sql"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.16"
  }
}
