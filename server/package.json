{
  "name": "glam-boutique-server",
  "version": "1.0.0",
  "private": true,
  "description": "API backend para Glam Boutique — MySQL, autenticação JWT, analytics, vendas e controle de despesas",
  "author": "AlawanderF",
  "license": "MIT",
  "keywords": [
    "api",
    "backend",
    "express",
    "mysql",
    "glam-boutique",
    "jwt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlawanderF/glam-boutique.git"
  },
  "bugs": {
    "url": "https://github.com/AlawanderF/glam-boutique/issues"
  },
  "homepage": "https://github.com/AlawanderF/glam-boutique#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:schema": "node scripts/runSqlFile.js schema.sql",
    "db:seed": "node scripts/runSqlFile.js seed.sql",
    "db:setup": "node scripts/runSqlFile.js schema.sql && node scripts/runSqlFile.js seed.sql",
    "db:reset": "node scripts/runSqlFile.js schema.sql"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@types/express": "^4.17.21"
  }
}
