# ============================================================
# Glam Boutique — Frontend
# ============================================================
# Copie para .env.local: cp .env.example .env.local
# NUNCA commite o .env.local!

# URL da API backend (sem trailing slash)
# Local: http://localhost:3333
# Produção: https://api.glamboutique.com.br
VITE_API_URL=http://localhost:3333

# Google Analytics 4 (opcional)
VITE_GA4_ID=G-XXXXXXXXXX

# Base path para GitHub Pages (deixe vazio ou / para root)
VITE_BASE_PATH=/
